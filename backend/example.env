PORT=3000
MONGODB_URI=
NODE_ENV=development

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Comma separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Use "none" only when the frontend and API are on different sites.
# "none" requires HTTPS and a Secure cookie.
COOKIE_SAME_SITE=lax

# Optional. Leave empty for a host-only cookie.
COOKIE_DOMAIN=

# Access token lifetime. Keep this short.
JWT_ACCESS_TTL=15m

# Refresh token/session lifetime in days.
REFRESH_TOKEN_TTL_DAYS=30

# Number of reverse proxies in front of Express (0 for local development).
TRUST_PROXY_HOPS=0
